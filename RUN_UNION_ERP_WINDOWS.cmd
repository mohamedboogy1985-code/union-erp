@echo off
chcp 65001 > nul
echo ===================================================================
echo   Union Financial ERP - النظام المالي والمحاسبي للنقابة العامة
echo ===================================================================
echo [1/3] فحص المنفذ 3000 وإغلاق العمليات المعلقة...
for /f "tokens=5" %%a in ('netstat -aon ^| findstr :3000') do taskkill /f /pid %%a >nul 2>&1

echo [2/3] تشغيل الخادم المركزي وقاعدة البيانات المحاسبية...
start /b npm run dev

echo [3/3] فتح النظام المالي في المتصفح وتجهيز بيئة سطح المكتب...
timeout /t 3 > nul
start http://localhost:3000
echo تم تشغيل النظام بنجاح.
pause
