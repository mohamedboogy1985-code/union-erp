# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# ─── أمان الإنتاج (Production Security) ─────────────────────────────
# وضع التشغيل الآمن: تعطيل المستخدم التجريبي الافتراضي وكلمات مرور bcrypt الصارمة.
# القيمة الوحيدة التي تفعّل الوضع الصارم هي false (بدون مسافات).
DEMO_MODE=false

# مفاتيح سرية قوية عشوائية (32 بايت hex) — استبدل أي منها بقيمك الخاصة عند النشر
JWT_SECRET=replace_with_a_strong_random_32_byte_hex_key
ENCRYPTION_KEY=replace_with_a_strong_random_32_byte_hex_key

# مفتاح Google Gemini للذكاء الاصطناعي (اختياري إن لم يتوفر)
GEMINI_API_KEY=

# ─── مدير حقيقي (مطلوب لتشغيل Jules؛ لا توجد كلمة مرور افتراضية) ────
# شغّل محلياً npm run auth:hash-password ثم احفظ البصمة سراً بين اقتباسين مفردين.
ERP_ADMIN_USER_ID=usr-mohamed-abdallah
ERP_ADMIN_PASSWORD_HASH=

# ─── Jules coding agent (اختياري؛ معطّل افتراضياً) ─────────────────
# راجع docs/JULES.md ومحتوى المستودع وتاريخه قبل مشاركته مع Google.
# يلزم DEMO_MODE=false، وأسرار قوية، ومدير موثّق بكلمة مرور.
# مفتاح Jules مستقل عن Gemini؛ لا تستخدم بادئة VITE_ ولا ترسله إلى المتصفح.
JULES_ENABLED=false
JULES_API_KEY=
JULES_REPOSITORY=mohamedboogy1985-code/union-erp
JULES_STARTING_BRANCH=arena/01a07898-union-erp
