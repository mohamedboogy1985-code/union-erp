# Auto detect text files and normalize line endings to LF
* text=auto

# Source code
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.less text eol=lf
*.html text eol=lf

# Configuration files
.editorconfig text eol=lf
.eslintrc* text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.prettierrc* text eol=lf
tsconfig.json text eol=lf
*.config.* text eol=lf
Makefile text eol=lf

# Documentation
*.md text eol=lf
*.markdown text eol=lf
*.txt text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Windows batch files (keep CRLF for Windows)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.gz binary
*.tar binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.pdf binary
