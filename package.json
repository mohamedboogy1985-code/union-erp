{
  "name": "union-app",
  "version": "1.1.0",
  "description": "نظام الإدارة المحاسبية الذكي - Intelligent Accounting Management System",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx watch --ignore pgdata --clear-screen=false server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server.ts",
    "test": "tsx test/accounting.test.ts && tsx test/improvements.test.ts && tsx test/employee-affairs.test.ts && tsx test/regulation.test.ts && tsx test/attendance.test.ts && tsx test/journal-delete.test.ts && npm run test:jules && npm run test:operator-assistant && npm run test:assistant-setup && npm run test:voice-reply && npm run test:ai-no-fabrication && npm run test:ai-draft-token && npm run test:security-audit && npm run test:csv-identifiers && npm run test:skills && npm run test:report-csv && npm run test:portal-welcome && npm run test:ai-agent-overview && npm run test:promo-video && npm run test:hardening && npm run test:data-paths && npm run test:model-names && npm run test:swarm-tools && npm run test:aether-swarm && npm run test:synonyms && npm run test:rag",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "clean": "node -e \"const fs=require('fs');for(const d of ['dist','dist-server','release'])fs.rmSync(d,{recursive:true,force:true});console.log('cleaned')\"",
    "postinstall": "node scripts/patch-electron-builder.mjs",
    "build:frontend": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist-server/index.cjs --external:vite --external:sharp --external:@google-cloud/vision --external:tesseract.js --external:redis --external:fsevents --external:embedded-postgres --log-level=warning",
    "electron:dev": "electron .",
    "electron:ensure": "install-electron",
    "electron:dir": "npm run electron:ensure && npm run build:frontend && npm run build:server && electron-builder --win --dir",
    "electron:build": "npm run electron:ensure && npm run build:frontend && npm run build:server && electron-builder --win nsis portable",
    "contract:emit": "prisma contract emit",
    "test:jules": "tsx --test test/jules.test.ts test/jules-ui.test.tsx",
    "auth:hash-password": "node scripts/hash-password.mjs",
    "typecheck:jules": "tsc --noEmit -p tsconfig.jules.json",
    "test:operator-assistant": "tsx --test test/operator-assistant.test.ts test/operator-assistant-ui.test.tsx",
    "typecheck:operator-assistant": "tsc --noEmit -p tsconfig.operator-assistant.json",
    "test:server-bundle": "npm run build && npm run build:server && node scripts/smoke-server-bundle.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "assistant:setup": "node scripts/configure-operator-assistant.mjs",
    "assistant:check": "node scripts/configure-operator-assistant.mjs --check",
    "test:assistant-setup": "tsx --test test/operator-setup.test.ts",
    "test:voice-reply": "tsx --test test/local-voice-reply.test.ts",
    "test:ai-no-fabrication": "tsx --test test/ai-no-fabrication.test.ts",
    "test:ai-draft-token": "tsx --test test/ai-draft-token.test.ts",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "test:security-audit": "tsx --test test/security-audit-chain.test.ts",
    "test:csv-identifiers": "tsx --test test/csv-import-identifiers.test.ts",
    "test:skills": "tsx --test test/skills.test.ts",
    "test:report-csv": "tsx --test test/report-csv.test.ts",
    "test:portal-welcome": "tsx --test test/portal-welcome.test.tsx",
    "test:ai-agent-overview": "tsx --test test/ai-agent-overview.test.tsx",
    "test:promo-video": "tsx --test test/promo-video.test.ts",
    "test:hardening": "tsx --test test/production-hardening.test.ts",
    "test:data-paths": "tsx --test test/data-paths.test.ts",
    "test:model-names": "tsx --test test/ai-model-names.test.ts",
    "test:swarm-tools": "tsx --test test/swarm-erp-tools.test.ts test/swarm-tools-routes.test.ts",
    "test:aether-swarm": "tsx --test test/aether-swarm.test.ts",
    "test:synonyms": "tsx --test test/smart-agent-synonyms.test.ts",
    "test:rag": "tsx --test test/rag-and-migrations.test.ts",
    "test:e2e": "playwright test",
    "test:load": "k6 run scripts/load-test.k6.js",
    "assets:compress": "tsx scripts/compress-assets.ts",
    "db:migrations:check": "tsx scripts/apply-migrations.ts",
    "rag:seed": "tsx scripts/seed-rag.ts"
  },
  "keywords": [
    "accounting",
    "ai",
    "arabic",
    "ocr",
    "voice-recognition",
    "journal-entry",
    "union",
    "financial-management"
  ],
  "author": "mohamedboogy1985-code",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@prisma/client": "^5.22.0",
    "@prisma/orm-postgres": "^8.0.0-rc.8",
    "@types/pg": "^8.23.1",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "8.7.0",
    "express-validator": "^7.0.0",
    "firebase": "^12.18.0",
    "google-auth-library": "^9.15.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.43.0",
    "multer": "^2.2.0",
    "pg": "^8.11.1",
    "pino": "^8.21.0",
    "pino-pretty": "^10.3.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "redis": "^4.7.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.19.43",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.11",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "embedded-postgres": "^18.4.0-beta.17",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "jsdom": "^30.0.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.1.1",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.1.14",
    "ts-jest": "^29.1.1",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "optionalDependencies": {
    "@google-cloud/vision": "^4.3.3",
    "sharp": "^0.35.4",
    "tesseract.js": "^4.1.4"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.2"
    }
  }
}
