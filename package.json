{
  "name": "union-app",
  "version": "1.1.0",
  "description": "نظام الإدارة المحاسبية الذكي - Intelligent Accounting Management System",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx watch --ignore pgdata --clear-screen=false server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server.ts",
    "test": "tsx test/accounting.test.ts && tsx test/improvements.test.ts && tsx test/employee-affairs.test.ts && tsx test/regulation.test.ts && tsx test/attendance.test.ts",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "clean": "node -e \"const fs=require('fs');for(const d of ['dist','dist-server','release'])fs.rmSync(d,{recursive:true,force:true});console.log('cleaned')\"",
    "postinstall": "node scripts/patch-electron-builder.mjs",
    "build:frontend": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist-server/index.cjs --external:vite --external:sharp --external:@google-cloud/vision --external:tesseract.js --external:redis --external:fsevents --external:embedded-postgres --log-level=warning",
    "electron:dev": "electron .",
    "electron:dir": "npm run build:frontend && npm run build:server && electron-builder --win --dir",
    "electron:build": "npm run build:frontend && npm run build:server && electron-builder --win nsis portable",
    "contract:emit": "prisma contract emit"
  },
  "keywords": [
    "accounting",
    "ai",
    "arabic",
    "ocr",
    "voice-recognition",
    "journal-entry",
    "union",
    "financial-management"
  ],
  "author": "mohamedboogy1985-code",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@prisma/client": "^5.22.0",
    "@prisma/orm-postgres": "^8.0.0-rc.8",
    "@types/pg": "^8.23.1",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "express-validator": "^7.0.0",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "google-auth-library": "^9.15.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.43.0",
    "multer": "^1.4.5-lts.2",
    "pg": "^8.11.1",
    "pino": "^8.21.0",
    "pino-pretty": "^10.3.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "redis": "^4.7.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.19.43",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "embedded-postgres": "^18.4.0-beta.17",
    "esbuild": "^0.25.12",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "jsdom": "^30.0.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.1.1",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.1.14",
    "ts-jest": "^29.1.1",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "optionalDependencies": {
    "@google-cloud/vision": "^4.3.3",
    "sharp": "^0.35.4",
    "tesseract.js": "^4.1.4"
  }
}
