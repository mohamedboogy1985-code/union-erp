+export interface ParsedIntent {
+  action: IntentAction;
+  parameters: Record<string, string | number | boolean | null>;
+  function: string;
+  execution: "direct" | "draft";
+  confidence: number;
+  descriptionAr: string;
+  sourceText: string;
+}
