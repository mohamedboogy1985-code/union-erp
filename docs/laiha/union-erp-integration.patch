+      "عاملين",
+      "عن",
+      "لي",
+      "ده",
+      "هذا",
+      "هذه",
+    ]);
+    return text
+      .split(/\s+/)
+      .map((word) => word.trim())
+      .filter((word) => word.length > 1 && !stop.has(word))
+      .join(" ")
+      .trim();
+  }
