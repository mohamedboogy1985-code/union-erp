+<h2 id="5-%D8%A7%D9%84%D8%AE%D8%B7%D9%88%D8%A9-%D8%A7%D9%84%D8%AA%D8%A7%D9%84%D9%8A%D8%A9--%D8%AB%D9%84%D8%A7%D8%AB%D8%A9-%D9%85%D8%B3%D8%A7%D8%B1%D8%A7%D8%AA-%D8%AC%D8%A7%D9%87%D8%B2%D8%A9">5) الخطوة التالية — ثلاثة مسارات جاهزة</h2>
