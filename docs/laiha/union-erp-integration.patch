@@ -0,0 +1,82 @@
+import { Router } from 'express';
+import fs from 'node:fs';
+import path from 'node:path';
+import type { Request, Response } from 'express';
+import { erpStore } from '../db/store.js';
+import { REGULATION_LIBRARY_VIEW } from '../data/regulations-library.js';
+import { regulationChatService } from '../services/regulation-chat.service.js';
+import { normalizeForSearch, regulationSearchHaystack } from '../utils/regulation-search.js';
+
+/**
+ * ===== مسارات مكتبة اللوائح والمساعد التشريعي (شات بوت اللوائح) =====
+ * كل الإجابات من قاعدة اللوائح المُدرجة في ذاكرة البرنامج/PostgreSQL، بلا أي مصدر خارجي.
+ */
+export const createRegulationsRouter = (): Router => {
+  const router = Router();
+  const LAW35_DIR = path.join(process.cwd(), 'server', 'data', 'laws', 'law35-2018');
+
+  router.get('/overview', (_req: Request, res: Response) => {
+    res.json({
+      ...REGULATION_LIBRARY_VIEW(),
+      inDatabase: {
+        sources: erpStore.regulationSources.length,
+        documents: erpStore.regulationDocuments.length,
+        storedAt: new Date().toISOString(),
+      },
+    });
+  });
+
+  router.get('/sources', (_req: Request, res: Response) => {
+    res.json(erpStore.regulationSources);
+  });
+
+  router.get('/search', (req: Request, res: Response) => {
+    const q = String(req.query.q ?? '').trim();
+    const sourceId = req.query.sourceId ? String(req.query.sourceId) : null;
+    const limit = Math.min(Number(req.query.limit ?? 40) || 40, 200);
+    const needle = normalizeForSearch(q);
+    const rows = erpStore.regulationDocuments
+      .filter((doc) => (sourceId ? doc.sourceId === sourceId : true))
+      .filter((doc) => {
+        if (!needle) return true;
+        const hay = normalizeForSearch(regulationSearchHaystack(doc));
+        return needle.split(/\s+/).every((part) => hay.includes(part));
+      })
+      .slice(0, limit);
+    res.json({ query: q, sourceId, count: rows.length, documents: rows });
+  });
+
+  router.get('/documents/:id', (req: Request, res: Response) => {
+    const doc = erpStore.regulationDocuments.find((d) => d.id === req.params.id);
+    if (!doc) {
+      res.status(404).json({ error: 'البند غير موجود في قاعدة اللوائح.' });
+      return;
+    }
+    res.json(doc);
+  });
+
+  router.post('/chat', (req: Request, res: Response) => {
+    res.json(regulationChatService.ask(String(req.body?.question ?? '')));
+  });
+
+  router.get('/law35/pages/:page', (req: Request, res: Response) => {
+    const page = Math.min(Math.max(Number(req.params.page) || 1, 1), 17);
+    const file = path.join(LAW35_DIR, `page-${String(page).padStart(2, '0')}.jpg`);
+    if (!fs.existsSync(file)) {
+      res.status(404).json({ error: 'صفحة الملف المرفق غير موجودة.' });
+      return;
+    }
+    res.sendFile(file);
+  });
+
+  router.get('/law35/file', (_req: Request, res: Response) => {
+    const file = path.join(LAW35_DIR, 'قرار-35-لسنة-2018-اللائحة-التنفيذية.pdf');
+    if (!fs.existsSync(file)) {
+      res.status(404).json({ error: 'الملف المرفق غير موجود.' });
+      return;
+    }
+    res.sendFile(file);
+  });
+
+  return router;
+};
diff --git a/server/routes/statute.routes.ts b/server/routes/statute.routes.ts
