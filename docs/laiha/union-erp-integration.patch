+    if (!draft.lines.length) {
+      return {
+        ...base,
+        replyAr:
+          "سمعت الطلب، بس معرفتش أستخرج سطور القيد كاملة — زوّد المبلغ أو حدّد الحساب، أو افتح «وكيل القيود الصوتية» وكمّل السطور بنفسك.",
