+import { Router } from "express";
+import type { Request, Response } from "express";
+import { voiceJournalService } from "../services/voice-journal.service.js";
+import type { VoiceDraftStatus } from "../services/voice-journal.service.js";
+import type { User } from "../../src/types/erp.js";
+
+interface VoiceJournalDeps {
+  authenticate: (req: Request) => User | null;
+  auditWrite?: (entry: Record<string, unknown>) => void;
+}
+
+/** مسارات وكيل القيود الصوتية: تحليل الإملاء → مسودة للمراجعة → اعتماد وترحيل. */
+export const createVoiceJournalRouter = (deps: VoiceJournalDeps): Router => {
+  const router = Router();
+
+  const actor = (req: Request, res: Response): User | null => {
+    const user = deps.authenticate(req);
+    if (!user) {
+      res.status(401).json({ error: "مطلوب تسجيل دخول صالح." });
+      return null;
+    }
+    return user;
+  };
+
+  router.get("/drafts", (req: Request, res: Response) => {
+    const status = req.query.status
+      ? (String(req.query.status) as VoiceDraftStatus)
+      : undefined;
+    res.json({
+      drafts: voiceJournalService.list(status),
+      counts: {
+        pending: voiceJournalService.list("PENDING_REVIEW").length,
+        approved: voiceJournalService.list("APPROVED").length,
+        posted: voiceJournalService.list("POSTED").length,
+        rejected: voiceJournalService.list("REJECTED").length,
+      },
+    });
+  });
+
+  router.post("/parse", (req: Request, res: Response) => {
+    const user = actor(req, res);
+    if (!user) return;
+    try {
+      const draft = voiceJournalService.parse({
+        transcript: String(req.body?.transcript ?? ""),
+        user,
+        organizationId: String(req.body?.organizationId ?? "org-general"),
+      });
+      res.json(draft);
+    } catch (err: any) {
+      res.status(400).json({ error: err.message });
+    }
+  });
+
+  router.post("/drafts", (req: Request, res: Response) => {
+    const user = actor(req, res);
+    if (!user) return;
+    const body = req.body ?? {};
+    if (!body.transcript && !Array.isArray(body.lines)) {
+      res.status(400).json({ error: "لا يوجد إملاء ولا سطور لحفظها." });
+      return;
+    }
+    const draft =
+      body.id && voiceJournalService.find(String(body.id))
+        ? voiceJournalService.update(String(body.id), {
+            date: body.date,
+            description: body.description,
+            lines: body.lines,
+            type: body.type,
+          })
+        : voiceJournalService.save({
+            ...voiceJournalService.parse({
+              transcript: String(body.transcript ?? body.description ?? ""),
+              user,
+            }),
+            ...body,
+          });
+    deps.auditWrite?.({
+      action: "VOICE_DRAFT_SAVED",
+      draftId: draft.id,
+      lines: draft.lines.length,
+      userId: user.id,
+    });
+    res.status(201).json(draft);
+  });
+
+  router.patch("/drafts/:id", (req: Request, res: Response) => {
+    const user = actor(req, res);
+    if (!user) return;
+    try {
+      const draft = voiceJournalService.update(req.params.id, req.body ?? {});
+      res.json(draft);
+    } catch (err: any) {
+      res.status(400).json({ error: err.message });
+    }
+  });
+
+  router.post("/drafts/:id/approve", (req: Request, res: Response) => {
+    const user = actor(req, res);
+    if (!user) return;
+    try {
+      const result = voiceJournalService.approveAndPost(
+        req.params.id,
+        user,
+        String(req.body?.organizationId ?? "org-general"),
+      );
+      deps.auditWrite?.({
+        action: "VOICE_DRAFT_APPROVED",
+        draftId: req.params.id,
+        entryId: result.entry.id,
+        posted: result.posted,
+        userId: user.id,
+      });
+      res.json(result);
+    } catch (err: any) {
+      res.status(400).json({ error: err.message });
+    }
+  });
+
+  router.post("/drafts/:id/reject", (req: Request, res: Response) => {
+    const user = actor(req, res);
+    if (!user) return;
+    try {
+      const draft = voiceJournalService.reject(
+        req.params.id,
+        user,
+        req.body?.note,
+      );
+      deps.auditWrite?.({
+        action: "VOICE_DRAFT_REJECTED",
+        draftId: req.params.id,
+        userId: user.id,
+      });
+      res.json(draft);
+    } catch (err: any) {
+      res.status(400).json({ error: err.message });
+    }
+  });
+
+  return router;
+};
diff --git a/server/services/accounting-core.service.ts b/server/services/accounting-core.service.ts
