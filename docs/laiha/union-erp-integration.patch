+                    </div>
+                  </td>
+                </tr>
+              ))}
+              {queue.length === 0 && (
+                <tr>
+                  <td colSpan={6} className="py-6 text-center text-slate-500">
+                    لا مسودات بعد — سجّل إملاءً بالصوت أو نصاً واضغط «حلّل
+                    الإملاء إلى قيد».
+                  </td>
