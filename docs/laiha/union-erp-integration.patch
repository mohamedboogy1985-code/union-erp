+  entries: { title: 'القيود اليومية', sub: 'قيد مزدوج بالقروش: فحص • إنشاء • ترحيل • عكس — وبوابة اللائحة قبل الإنشاء', render: viewEntries, bind: bindEntries },
+  chart: { title: 'دليل الحسابات الموحد', sub: '118 حساباً من ملف مستودعك • 9 أقسام • 32 كوداً مساعداً • ملاحظات القرار', render: viewChart, bind: bindChart },
+  trial: { title: 'ميزان المراجعة', sub: 'كل الحسابات (118) مع الإجماليات وتوازن المدين والدائن', render: viewTrial, bind: bindTrial },
+  subledger: { title: 'الأطراف التحليلية', sub: 'إنشاء ومطابقة بتطبيع عربي — بلا دمج صامت', render: viewSubledger, bind: bindSubledger },
+  chain: { title: 'سلسلة التحقق وسجل التدقيق', sub: 'ترابط SHA-256 لكل قيد + سجل كل عملية', render: viewChain, bind: bindChain },
+  financial: { title: 'بوابة اللائحة المالية', sub: '90 قاعدة • 53 عتبة بنصّها من المواد', render: viewFinancial, bind: bindFinancial },
+  statute: { title: 'لوحة النظام الأساسي', sub: '69 مادة • 113 قاعدة • تغطية 100% • الاعتماد والنشر وخطة التفعيل', render: viewStatute, bind: bindStatute },
+  simulators: { title: 'محاكيا الفحص', sub: 'حكامة وعضوية: عدّل الحقول واعرف النتيجة ورقم المادة والعلاج', render: viewSimulators, bind: bindSimulators },
+};
+
+function render() {
+  const config = VIEWS[S.route] || VIEWS.overview;
+  $('viewTitle').textContent = config.title;
+  $('viewSub').textContent = config.sub;
+  view().innerHTML = config.render();
+  if (config.bind) config.bind();
+  renderNavState();
+}
+
+document.querySelectorAll('.nav button').forEach((button) => {
+  button.onclick = () => { S.route = button.dataset.view; render(); window.scrollTo(0, 0); };
+});
+$('stage').onchange = (event) => { S.stage = event.target.value; toast(`مرحلة البوابة: ${S.stage}`); if (S.route === 'entries') render(); };
+$('reload').onclick = async () => { await loadAll(); render(); toast('تم تحديث البيانات'); };
+
+(async () => {
+  try {
+    await loadAll();
+    render();
+  } catch (error) {
+    view().innerHTML = `<div class="notice bad">تعذّر تحميل البيانات من الخادم. شغّل البرنامج بالأمر <span class="mono">node .build/server/demo/demo-server.js</span> ثم أعد تحميل الصفحة.</div>`;
+  }
+})();
+</script>
+</body>
+</html>
