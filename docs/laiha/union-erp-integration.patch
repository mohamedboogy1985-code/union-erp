+import { Router } from 'express';
+import type { Request, Response } from 'express';
+import { biometricService, isBiometricPayrollApprover, BIOMETRIC_APPROVER_NAME_AR } from '../services/biometric.service.js';
+import { payrollService } from '../services/payroll.service.js';
+import { can } from '../security/permissions.js';
+import type { User } from '../../src/types/erp.js';
+
+interface BiometricRouterDeps {
+  authenticate: (req: Request) => User | null;
+  auditWrite?: (entry: Record<string, unknown>) => void;
+}
+
+/** مسارات بصمة اليد والوجه وربطها بالمراتب — الاعتماد مقصور على محمد عبد الله أحمد. */
+export const createBiometricRouter = (deps: BiometricRouterDeps): Router => {
+  const router = Router();
+
+  const actor = (req: Request, res: Response): User | null => {
+    const user = deps.authenticate(req);
+    if (!user) {
+      res.status(401).json({ error: 'مطلوب تسجيل دخول صالح.' });
+      return null;
+    }
+    return user;
+  };
+
+  router.get('/overview', (req: Request, res: Response) => {
+    const user = deps.authenticate(req);
+    const year = req.query.year ? Number(req.query.year) : undefined;
+    const month = req.query.month ? Number(req.query.month) : undefined;
+    res.json(biometricService.overview(year, month, user));
+  });
+
+  router.get('/link', (_req: Request, res: Response) => {
+    res.json({
+      ...biometricService.payrollLink(),
+      approverNameAr: BIOMETRIC_APPROVER_NAME_AR,
+      effectsAr: biometricService.overview().effectsAr,
+    });
+  });
+
+  router.post('/enroll', (req: Request, res: Response) => {
+    const user = actor(req, res);
+    if (!user) return;
+    try {
+      const enrollment = biometricService.enroll(user, req.body ?? {});
+      deps.auditWrite?.({ action: 'BIOMETRIC_ENROLL', employeeId: enrollment.employeeId, methods: enrollment.methods, userId: user.id });
+      res.status(201).json(enrollment);
+    } catch (err: any) {
+      res.status(400).json({ error: err.message });
+    }
+  });
+
+  router.delete('/enroll/:employeeId', (req: Request, res: Response) => {
+    const user = actor(req, res);
+    if (!user) return;
+    try {
+      biometricService.removeEnrollment(user, req.params.employeeId);
+      res.json({ success: true, message: 'حُذف قالب البصمة.' });
+    } catch (err: any) {
+      res.status(400).json({ error: err.message });
+    }
+  });
+
+  router.post('/punch', (req: Request, res: Response) => {
+    const user = actor(req, res);
+    if (!user) return;
+    try {
+      const result = biometricService.punch(user, req.body ?? {});
+      deps.auditWrite?.({ action: 'BIOMETRIC_PUNCH', employeeId: result.punch.employeeId, method: result.punch.method, direction: result.punch.direction, userId: user.id });
+      res.status(201).json(result);
+    } catch (err: any) {
+      res.status(400).json({ error: err.message });
+    }
+  });
+
+  router.post('/payroll-link/request', (req: Request, res: Response) => {
+    const user = actor(req, res);
+    if (!user) return;
+    try {
+      const state = biometricService.requestPayrollLink(user, req.body?.noteAr, req.body?.appliedMonth);
+      deps.auditWrite?.({ action: 'BIOMETRIC_LINK_REQUESTED', userId: user.id, appliedMonth: state.appliedMonth });
+      res.status(201).json(state);
+    } catch (err: any) {
+      res.status(400).json({ error: err.message });
+    }
+  });
+
+  router.post('/payroll-link/decide', (req: Request, res: Response) => {
+    const user = actor(req, res);
+    if (!user) return;
+    if (!isBiometricPayrollApprover(user)) {
+      res.status(403).json({ error: `اعتماد ربط البصمة بالمراتب مقصور على ${BIOMETRIC_APPROVER_NAME_AR}.` });
+      return;
+    }
+    const approved = req.body?.approved !== false;
+    try {
+      const state = biometricService.decidePayrollLink(user, approved, req.body?.noteAr);
+      deps.auditWrite?.({ action: approved ? 'BIOMETRIC_LINK_APPROVED' : 'BIOMETRIC_LINK_REJECTED', userId: user.id, noteAr: state.noteAr });
+      res.json(state);
+    } catch (err: any) {
+      res.status(400).json({ error: err.message });
+    }
+  });
+
+  /** توليد/اعتماد/ترحيل المسير من الشاشة نفسها مع مراعاة حالة الربط. */
+  router.post('/payroll/generate', (req: Request, res: Response) => {
+    const user = actor(req, res);
+    if (!user) return;
+    if (!can(user, 'hr:manage')) {
+      res.status(403).json({ error: 'تحتاج صلاحية إدارة الموارد البشرية لتوليد المسير.' });
+      return;
+    }
+    try {
+      const run = payrollService.generateRun(user, {
+        year: Number(req.body?.year) || new Date().getFullYear(),
+        month: Number(req.body?.month) || new Date().getMonth() + 1,
+        useAttendance: biometricService.isPayrollLinkApproved(),
+        notes: biometricService.isPayrollLinkApproved() ? 'مسير مبني على بصمة الحضور (ربط معتمد)' : 'مسير بدون ربط بصمة (الربط غير معتمد)',
+      });
+      deps.auditWrite?.({ action: 'PAYROLL_GENERATED_FROM_BIOMETRIC', runId: run.id, basedOnAttendance: run.basedOnAttendance, userId: user.id });
+      res.status(201).json(run);
+    } catch (err: any) {
+      res.status(400).json({ error: err.message });
+    }
+  });
+
+  return router;
+};
