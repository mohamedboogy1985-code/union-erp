+const EXPLICIT_EXECUTION = [
+  "نفذ",
+  "سجل",
+  "اعتمد",
+  "ارحل",
+  "رحل",
+  "ارحله",
+  "ضيف للدفاتر",
+  "اعمل واعتمد",
