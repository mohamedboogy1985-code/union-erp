+<title>تقرير مراجعة فنية وتطويرية — Union Financial ERP</title>
+<style>
+:root { color-scheme: dark; }
+* { box-sizing: border-box; }
+body { margin: 0; background: #0b1220; color: #e2e8f0; font-family: "Segoe UI", "Tahoma", "Arial", sans-serif; line-height: 1.95; }
+.wrap { max-width: 1100px; margin: 0 auto; padding: 32px 20px 80px; }
+header.hero { border: 1px solid #1e293b; background: linear-gradient(180deg, #0f172a 0%, #0b1220 100%); border-radius: 20px; padding: 26px 24px; margin-bottom: 26px; }
