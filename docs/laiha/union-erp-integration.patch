+    singular: "مليار",
+    dual: "ملياران",
+    plural: "مليارات",
+  },
+  { value: 1_000_000, singular: "مليون", dual: "مليونان", plural: "ملايين" },
+  { value: 1_000, singular: "ألف", dual: "ألفان", plural: "آلافِ" },
+];
+const ID_PREFIXES: Record<string, string> = {
+  INV: "فاتورة",
