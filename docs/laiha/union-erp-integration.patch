+
+    if (!isExplicit(text)) {
+      return {
+        ...base,
+        replyAr: `جهزت لك مسودة قيد: ${detail} — بإجمالي ${fmt(total)} ج، وهي بانتظار مراجعتك واعتمادك. اضغط «نفّذ» وأعتمدها وأرحّلها فوراً.`,
+        steps: [
