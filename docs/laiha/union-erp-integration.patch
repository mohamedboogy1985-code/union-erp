+/** مطابقة آمنة: تُطبّع الكلمة المطلوبة بنفس تطبيع النص فلا تفشل بسبب (ة/ه) أو (ئ/ي) أو (أ/ا). */
+const has = (text: string, patterns: string[]): boolean =>
