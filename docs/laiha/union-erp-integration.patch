+@echo off
+setlocal
+cd /d "%~dp0"
+title Union ERP - production server
+where node >nul 2>nul
+if errorlevel 1 (
+  echo Node.js not found. Install Node.js 20 or newer from https://nodejs.org
+  pause
+  exit /b 1
