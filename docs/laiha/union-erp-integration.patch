@@ -0,0 +1,118 @@
+import type { Request, Response, Router } from 'express';
+import express from 'express';
+import {
+  accountBalance,
+  accountLedger,
+  accountingHistory,
+  auditChartGrounding,
+  chainHealth,
+  chartStats,
+  createEntry,
+  findAccounts,
+  findOrCreateSubledgerParty,
+  guideMappingStatus,
+  getAccountByCode,
+  listEntries,
+  listSubledgerParties,
+  postEntry,
+  reverseEntry,
+  treasuryMappingStatus,
+  trialBalance,
+  validateEntry,
+} from '../services/accounting-core.service.js';
+import { CHART_ACCOUNTS, CHART_ANOMALIES, CHART_DOCUMENT, CHART_OPEN_ITEMS, CHART_SECTIONS } from '../data/chart-of-accounts.js';
+import type { JournalEntryInput } from '../../src/types/erp.accounting.js';
+
+export interface AccountingRouterDeps {
+  authenticate?: (req: Request) => { id: string; role: string } | null;
+  auditWrite?: (entry: Record<string, unknown>) => void;
+  enforcementStage?: string;
+}
+
+export const createAccountingRouter = (deps: AccountingRouterDeps = {}): Router => {
+  const router = express.Router();
+  const stage = deps.enforcementStage ?? 'ENFORCE';
+
+  router.get('/chart', (_req: Request, res: Response) => {
+    res.json({
+      document: CHART_DOCUMENT,
+      stats: chartStats(),
+      sections: CHART_SECTIONS,
+      anomalies: CHART_ANOMALIES,
+      openItems: CHART_OPEN_ITEMS,
+      mapping: guideMappingStatus(),
+      treasury: treasuryMappingStatus(),
+    });
+  });
+
+  router.get('/grounding', (_req: Request, res: Response) =>
+    res.json({ ...auditChartGrounding(), mapping: guideMappingStatus(), treasury: treasuryMappingStatus() }));
+
+  router.get('/accounts', (req: Request, res: Response) => {
+    const query = String(req.query.q ?? '');
+    res.json({ accounts: query ? findAccounts(query, Number(req.query.limit ?? 20)) : CHART_ACCOUNTS });
+  });
+
+  router.get('/accounts/:code', (req: Request, res: Response) => {
+    const account = getAccountByCode(String(req.params.code));
+    if (!account) {
+      res.status(404).json({ errorAr: `لا يوجد حساب بالكود ${req.params.code} في الدليل الموحد.` });
+      return;
+    }
+    res.json({ account, balanceMinor: accountBalance(account.code), ledger: accountLedger(account.code) });
+  });
+
+  router.post('/validate', (req: Request, res: Response) => {
+    const input = (req.body ?? {}) as JournalEntryInput;
+    res.json(validateEntry(input));
+  });
+
+  router.post('/entries', (req: Request, res: Response) => {
+    const user = deps.authenticate?.(req) ?? null;
+    const input = { ...(req.body ?? {}), userId: user?.id ?? 'system' } as JournalEntryInput;
+    const requestStage = String(req.query.stage ?? stage);
+    const verdict = createEntry(input, { stage: requestStage, enforceRegulation: true });
+    deps.auditWrite?.({
+      action: verdict.ok ? 'ACCOUNTING_ENTRY_CREATED' : 'ACCOUNTING_ENTRY_REJECTED',
+      entity: 'JournalEntry',
+      payload: { reference: verdict.entry?.referenceNo ?? null, issues: verdict.issues.map((issue) => issue.code) },
+    });
+    res.json(verdict);
+  });
+
+  router.post('/entries/:id/post', (req: Request, res: Response) => {
+    const user = deps.authenticate?.(req) ?? null;
+    const verdict = postEntry(String(req.params.id), user?.id ?? 'system');
+    deps.auditWrite?.({ action: 'ACCOUNTING_ENTRY_POSTED', entity: 'JournalEntry', payload: { id: req.params.id, ok: verdict.ok } });
+    res.json(verdict);
+  });
+
+  router.post('/entries/:id/reverse', (req: Request, res: Response) => {
+    const user = deps.authenticate?.(req) ?? null;
+    const reason = String((req.body as { reasonAr?: string })?.reasonAr ?? 'بدون سبب معلن');
+    res.json(reverseEntry(String(req.params.id), reason, user?.id ?? 'system'));
+  });
+
+  router.get('/entries', (_req: Request, res: Response) => {
+    res.json({ entries: listEntries(), history: accountingHistory(), chain: chainHealth() });
+  });
+
+  router.get('/trial-balance', (_req: Request, res: Response) => res.json(trialBalance()));
+  router.get('/chain', (_req: Request, res: Response) => res.json(chainHealth()));
+
+  router.get('/subledger', (req: Request, res: Response) => {
+    const code = req.query.accountCode ? String(req.query.accountCode) : undefined;
+    res.json({ parties: listSubledgerParties(code) });
+  });
+
+  router.post('/subledger', (req: Request, res: Response) => {
+    const body = (req.body ?? {}) as { accountCode?: string; name?: string };
+    try {
+      res.json(findOrCreateSubledgerParty(String(body.accountCode), String(body.name ?? '')));
+    } catch (error) {
+      res.json({ errorAr: (error as Error).message });
+    }
+  });
+
+  return router;
+};
