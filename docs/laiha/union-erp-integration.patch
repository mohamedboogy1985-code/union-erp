+            status: "done",
+            detailAr: `رقم المسودة ${saved.id}`,
+          },
+          {
+            labelAr: "الاعتماد والترحيل",
+            status: "pending",
+            detailAr: "بانتظار تأكيدك",
+          },
+        ],
+        payload: {
+          kind: "metrics",
+          metrics: [
+            {
