# Server
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Database
# PostgreSQL المضمّن يعمل تلقائياً عند الإقلاع إذا لم تضبط SQL_HOST
# (ثنائيات حقيقية عبر npm والبيانات تدوم في مجلد pgdata)
DISABLE_EMBEDDED_PG=false
PG_DATA_DIR=./pgdata
# لتوجيه النظام لقاعدة خارجية بدل المضمّنة اضبط ما يلي:
# SQL_HOST=localhost
# SQL_USER=postgres
# SQL_PASSWORD=postgres
# SQL_DB_NAME=union_app
DATABASE_URL=postgresql://union_user:password@localhost:5432/union_app
DB_HOST=localhost
DB_PORT=5432
DB_NAME=union_app
DB_USER=union_user
DB_PASSWORD=password

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d

# Google APIs
GEMINI_API_KEY=your_gemini_api_key
GOOGLE_CLOUD_PROJECT_ID=your_project_id
GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key

# Vision & OCR Services
VISION_API_KEY=your_vision_api_key
OCR_LANGUAGE=ar+en

# Voice & Whisper Services
WHISPER_API_KEY=your_whisper_api_key
SPEECH_LANGUAGE=ar-SA

# Redis
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password

# AI Model Settings
GEMINI_MODEL=gemini-pro
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=4096

# ===== Security Hardening (IMPROVEMENTS 5) =====
# Encryption master key for sensitive data (AES-256-GCM) - change in production
ENCRYPTION_KEY=change_me_32_byte_random_master_key
# ===== وضع التشغيل الأمني =====
# true  (افتراضي): وضع العرض التجريبي لتطبيق سطح المكتب — دخول بترويسة x-user-id،
#        ويُقبل الحساب بلا كلمة مرور bcrypt مخزنة.
# false للنشر الشبكي: JWT صالح إلزامي لكل عمليات الكتابة + كلمة مرور إلزامية،
#        ويُرفض الإقلاع بدون JWT_SECRET و ENCRYPTION_KEY قويين (≥16 حرفاً غير افتراضية).
DEMO_MODE=true
# وحدة تنفيذ SQL اليدوية (خاطرة): مقفلة افتراضياً في الوضع الصارم —
# تُفتح فقط بضبط true صراحةً (ولا يُنصح بها إطلاقاً في الإنتاج).
ALLOW_SQL_CONSOLE=false
# Login lockout policy
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15
# Rate limiting (requests per minute per IP)
RATE_LIMIT_MAX=300

# ===== Smart Features Thresholds =====
# Confirmation threshold for large voice-recorded entries (EGP)
VOICE_CONFIRMATION_THRESHOLD=50000
# Debtor alert threshold for account 1301 (EGP)
DEBTOR_ALERT_THRESHOLD=150000

# ===== Notification Channels (optional - simulated if empty) =====
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=no-reply@union-erp.org
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=UnionERP